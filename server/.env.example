# Copy this file to ".env" and fill in your own values.
PORT=5000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=stylehub
# Set to true for cloud databases such as Aiven
DB_SSL=false

# Any long random text. Used to sign login tokens.
JWT_SECRET=change_this_to_a_long_random_text

# The first admin account created by "npm run setup"
ADMIN_EMAIL=admin@stylehub.com
ADMIN_PASSWORD=admin123

# Razorpay (online payment). Get test keys: Razorpay dashboard > Account & Settings > API Keys.
# Leave empty to turn online payment off (customers can still use Cash on Delivery).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
